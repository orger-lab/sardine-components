<sardine:VesselUserControl x:Class="Sardine.Test.FictiveWorkload.Views.WPF.BusyLoad_UI"
                           x:TypeArguments="fictive:BusyLoad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sardine="clr-namespace:Sardine.Core.Views.WPF;assembly=Sardine.Core.Views.WPF"
             xmlns:fictive="clr-namespace:Sardine.Test.FictiveWorkload;assembly=Sardine.Test.FictiveWorkload"
             xmlns:local="clr-namespace:Sardine.Test.FictiveWorkload.Views.WPF"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignData IsDesignTimeCreatable=False, Type=fictive:BusyLoad}"
             Background="Gray"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <Label Content="#Cycles"/>
            <Slider x:Name="slider_Cycles" Minimum="1" Maximum="1000000" Value="{Binding Path=BusyCycles, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            <TextBox x:Name="textBox_Cycles" IsEnabled="False" Text="{Binding Path=BusyCycles, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            <Label Content="Difficulty"/>
            <Slider x:Name="slider_Difficulty" Minimum="1" Maximum="20" Value="{Binding Path=BusyDifficulty, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            <TextBox x:Name="textBox_Difficulty" IsEnabled="False" Text="{Binding Path=BusyDifficulty, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            <Label Content="Num Threads"/>
            <Slider x:Name="slider_Threads" Minimum="1" Maximum="{Binding Path=MaxThreads}" Value="{Binding Path=NumThreads, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            <TextBox x:Name="textBox_Threads" IsEnabled="False" Text="{Binding Path=NumThreads, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
        </StackPanel>
    </Grid>
</sardine:VesselUserControl>
